# CSTAN Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Secret Key for session cryptography (generate using: python -c 'import secrets; print(secrets.token_hex(24))')
SECRET_KEY=cstan-super-secure-production-secret-token-2026

# Database URI (defaults to SQLite: sqlite:///cstan.db or PostgreSQL: postgresql://user:pass@localhost:5432/cstandb)
DATABASE_URL=sqlite:///cstan.db

# Server Port (default: 5000)
PORT=5000

# Debug Mode (set False for production)
FLASK_DEBUG=False
